{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    // Inside the output dir so `rm -rf dist` really is a clean build, and so a
    // stale buildinfo from the host can never make tsc skip emitting in Docker.
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo"
  }
}
