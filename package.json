{
  "name": "scratchportal",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -e .env -- turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:push": "dotenv -e .env -- turbo run db:push",
    "db:seed": "dotenv -e .env -- turbo run db:seed",
    "db:studio": "dotenv -e .env -- turbo run db:studio",
    "infra:up": "docker compose up -d redis",
    "infra:down": "docker compose stop redis",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api-1 api-2",
    "audit": "docker compose exec -T api-1 sh -c 'cat /data/logs/audit-*.jsonl'",
    "audit:save": "docker compose exec -T api-1 sh -c 'cat /data/logs/audit-*.jsonl' > audit-export.jsonl"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=20"
  }
}
